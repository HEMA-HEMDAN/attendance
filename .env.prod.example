# Django Settings
SECRET_KEY=change_me_to_a_secure_random_string_in_production
DEBUG=False
ALLOWED_HOSTS=your_domain.com,www.your_domain.com,vps_ip_address

# Database Config (must match docker-compose.db.yml)
DB_NAME=attendance
DB_USER=postgres
DB_PASSWORD=postgres
# DB_HOST=db (Defined in docker-compose.yml)
DB_PORT=5432

# Redis Config
# REDIS_URL=redis://redis:6379/0 (Defined in docker-compose.yml)

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your_domain.com,https://www.your_domain.com
